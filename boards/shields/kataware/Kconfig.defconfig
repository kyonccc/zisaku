# トラックボールを付けた側 = セントラル(PC/スマホとBluetooth接続する側)
# 左右どちらでも、kataware_trackball を一緒に指定した側がセントラルになる
if SHIELD_KATAWARE_TRACKBALL

config ZMK_KEYBOARD_NAME
    default "kataware"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

# トラックボールセンサー(PMW3610)はSPIで通信する
config SPI
    default y

config PMW3610_ALT
    default y

endif

# 左右共通の設定
if SHIELD_KATAWARE_LEFT || SHIELD_KATAWARE_RIGHT

# 分割キーボードとして動作させる
config ZMK_SPLIT
    default y

# マウス機能(マウスボタン・カーソル移動)を有効化
config ZMK_POINTING
    default y

endif
