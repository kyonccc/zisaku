/*
 * 物理レイアウト(キーの見た目上の位置)
 * ZMK Studio などでキー配置を表示するときに使われます。
 * 単位は 1キー = 100 (= 19.05mm)。オーソリニア。
 *   左手: 5列 x 4段 + 4段目の内側に1キー (21キー)
 *   右手: 内側にトラックボール帯 + 5列 x 4段 (20キー)
 */

#include <physical_layouts.dtsi>

/ {
    kataware_layout: kataware_layout {
        compatible = "zmk,physical-layout";
        display-name = "Default";

        keys  //                     w   h    x    y  rot  rx  ry
            = <&key_physical_attrs 100 100    0    0    0   0   0>
            , <&key_physical_attrs 100 100  100    0    0   0   0>
            , <&key_physical_attrs 100 100  200    0    0   0   0>
            , <&key_physical_attrs 100 100  300    0    0   0   0>
            , <&key_physical_attrs 100 100  400    0    0   0   0>
            , <&key_physical_attrs 100 100  890    0    0   0   0>
            , <&key_physical_attrs 100 100  990    0    0   0   0>
            , <&key_physical_attrs 100 100 1090    0    0   0   0>
            , <&key_physical_attrs 100 100 1190    0    0   0   0>
            , <&key_physical_attrs 100 100 1290    0    0   0   0>
            , <&key_physical_attrs 100 100    0  100    0   0   0>
            , <&key_physical_attrs 100 100  100  100    0   0   0>
            , <&key_physical_attrs 100 100  200  100    0   0   0>
            , <&key_physical_attrs 100 100  300  100    0   0   0>
            , <&key_physical_attrs 100 100  400  100    0   0   0>
            , <&key_physical_attrs 100 100  890  100    0   0   0>
            , <&key_physical_attrs 100 100  990  100    0   0   0>
            , <&key_physical_attrs 100 100 1090  100    0   0   0>
            , <&key_physical_attrs 100 100 1190  100    0   0   0>
            , <&key_physical_attrs 100 100 1290  100    0   0   0>
            , <&key_physical_attrs 100 100    0  200    0   0   0>
            , <&key_physical_attrs 100 100  100  200    0   0   0>
            , <&key_physical_attrs 100 100  200  200    0   0   0>
            , <&key_physical_attrs 100 100  300  200    0   0   0>
            , <&key_physical_attrs 100 100  400  200    0   0   0>
            , <&key_physical_attrs 100 100  890  200    0   0   0>
            , <&key_physical_attrs 100 100  990  200    0   0   0>
            , <&key_physical_attrs 100 100 1090  200    0   0   0>
            , <&key_physical_attrs 100 100 1190  200    0   0   0>
            , <&key_physical_attrs 100 100 1290  200    0   0   0>
            , <&key_physical_attrs 100 100    0  300    0   0   0>
            , <&key_physical_attrs 100 100  100  300    0   0   0>
            , <&key_physical_attrs 100 100  200  300    0   0   0>
            , <&key_physical_attrs 100 100  300  300    0   0   0>
            , <&key_physical_attrs 100 100  400  300    0   0   0>
            , <&key_physical_attrs 100 100  500  300    0   0   0>
            , <&key_physical_attrs 100 100  890  300    0   0   0>
            , <&key_physical_attrs 100 100  990  300    0   0   0>
            , <&key_physical_attrs 100 100 1090  300    0   0   0>
            , <&key_physical_attrs 100 100 1190  300    0   0   0>
            , <&key_physical_attrs 100 100 1290  300    0   0   0>
            ;
    };
};
