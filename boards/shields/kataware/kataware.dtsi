/*
 * kataware 左右共通の定義
 *
 * マイコン: ProMicro nRF52840 互換 (nice!nano v2 等)
 * キー配置: オーソリニア 片手 5列 x 4段 + 左手4段目の内側に2キー (合計42キー)
 *           + 左手にロータリーエンコーダー (押し込みスイッチ付き)
 *           トラックボール(25mm)は右手の内側、4段目の高さ
 *
 * ピン番号の `&pro_micro N` は ProMicro の「D番号」です。
 * (例: &pro_micro 4 = D4 ピン)
 */

#include <dt-bindings/zmk/matrix_transform.h>
#include "kataware-layout.dtsi"

// 物理レイアウトとマトリックス変換を結びつける
&kataware_layout {
    transform = <&default_transform>;
};

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &kataware_layout;
    };

    /*
     * マトリックス変換: 「何行目・何列目のスイッチ」が
     * キーマップ上の「何番目のキー」になるかを決める表
     *
     *  左手 (COL0 が外側)                                   右手 (COL7 が内側)
     * | 0,0 | 0,1 | 0,2 | 0,3 | 0,4 |                      | 0,7 | 0,8 | 0,9 | 0,10| 0,11|
     * | 1,0 | 1,1 | 1,2 | 1,3 | 1,4 |                      | 1,7 | 1,8 | 1,9 | 1,10| 1,11|
     * | 2,0 | 2,1 | 2,2 | 2,3 | 2,4 | 2,5 |          (●)  | 2,7 | 2,8 | 2,9 | 2,10| 2,11|
     * | 3,0 | 3,1 | 3,2 | 3,3 | 3,4 | 3,5 | 3,6 |    ●    | 3,7 | 3,8 | 3,9 | 3,10| 3,11|
     *
     * 左手の 2,5 = エンコーダーの押し込み、3,5 = 英数キー、3,6 = 親指の段の一番内側のキー。
     * ● はトラックボール。
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <13>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)                    RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)                    RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)            RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)    RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11)
        >;
    };

    /*
     * キースキャン(マトリックス配線)
     * diode-direction = "col2row": ダイオードの向きは 列(COL) → 行(ROW)
     * (基板設計時のダイオードの向きと必ず合わせること)
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        row-gpios
            = <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW0 = D4
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW1 = D5
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW2 = D6
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  // ROW3 = D7
            ;
        // col-gpios は左右で並び順が違うので各 .overlay に書く
    };

    /*
     * ロータリーエンコーダー (左手のみ。左手の .overlay で有効にする)
     * A = D0, B = D1。押し込みスイッチはキーマトリックスの ROW2 x COL5 につなぐ
     */
    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "disabled";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder>;
        triggers-per-rotation = <20>;
    };

    /*
     * トラックボールの入力リスナー
     * 左右両方のビルドでキーマップから参照できるようにここで定義し、
     * 普段は無効(disabled)。kataware_trackball を指定した側だけで有効にする。
     */
    trackball_listener: trackball_listener {
        compatible = "zmk,input-listener";
        status = "disabled";
    };
};
