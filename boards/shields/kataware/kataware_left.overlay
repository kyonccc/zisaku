/*
 * 左手側 (5列 x 4段 + T・G の内側に2キー + 4段目の内側に2キー + ロータリーエンコーダー)
 */

#include "kataware.dtsi"

&kscan0 {
    col-gpios
        = <&pro_micro 21 GPIO_ACTIVE_HIGH>  // COL0 = D21 (一番外側)
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>  // COL1 = D20
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>  // COL2 = D19
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>  // COL3 = D18
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>  // COL4 = D15
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>  // COL5 = D14 (T・G の右の追加キー、エンコーダー押し込み、英数キー)
        , <&pro_micro 2 GPIO_ACTIVE_HIGH>   // COL6 = D2  (一番内側: 親指の段の追加キーだけ)
        ;
};

// ロータリーエンコーダーを有効化 (左手だけ)
&left_encoder {
    status = "okay";
};
