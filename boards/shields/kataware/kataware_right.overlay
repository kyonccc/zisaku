/*
 * 右手側 (5列 x 4段 + Y・H の内側に2キー + 内側にトラックボール)
 * kataware_trackball と一緒にビルドする (ボール付き = PCとつながる側)
 */

#include "kataware.dtsi"

// 右手側はキーマップ上で 7列目から始まる (0〜6列目は左手)
&default_transform {
    col-offset = <7>;
};

&kscan0 {
    col-gpios
        = <&pro_micro 21 GPIO_ACTIVE_HIGH>  // COL7  = D21 (一番内側: Y・H の左の追加キーだけ)
        , <&pro_micro 14 GPIO_ACTIVE_HIGH>  // COL8  = D14 (Y H N の列)
        , <&pro_micro 15 GPIO_ACTIVE_HIGH>  // COL9  = D15
        , <&pro_micro 18 GPIO_ACTIVE_HIGH>  // COL10 = D18
        , <&pro_micro 19 GPIO_ACTIVE_HIGH>  // COL11 = D19
        , <&pro_micro 20 GPIO_ACTIVE_HIGH>  // COL12 = D20 (一番外側)
        ;
};
