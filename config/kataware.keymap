/*
 * kataware キーマップ
 *
 * キーの割り当てはこのファイルを編集して変更します。
 * キーコード一覧: https://zmk.dev/docs/keymaps/list-of-keycodes
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

// レイヤー番号に名前を付けておく (数字を直接書くより分かりやすい)
#define BASE   0
#define LOWER  1
#define RAISE  2
#define MOUSE  3
#define SCROLL 4

/*
 * ===== トラックボールの動作設定 =====
 * - ボールを動かすと MOUSE レイヤーが自動でONになる (オートマウスレイヤー)
 *   → 右手ホームポジションのキーがクリックになる
 * - SCROLL レイヤー中はボールでスクロールする
 */
&zip_temp_layer {
    // 文字入力の直後 300ms はボールに触れてもマウスレイヤーにしない (誤爆防止)
    require-prior-idle-ms = <300>;
};

&trackball_listener {
    // 通常時: ボールを動かすと MOUSE レイヤーを 700ms だけONにする
    input-processors = <&zip_temp_layer MOUSE 700>;

    scroller {
        layers = <SCROLL>;
        // XY移動をスクロールに変換し、速度を 1/8 に落とす
        // スクロール方向が逆なら &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT を追加
        input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 8>;
    };
};

/*
 * キー配置図 (オーソリニア 4段 x 6列 x 左右)
 * トラックボールを付けた側は、ボールの場所のキーは押せない (使われないだけで害はない)
 */
/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: 基本レイヤー (QWERTY)
        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB   &kp Q    &kp W    &kp E     &kp R     &kp T        &kp Y   &kp U     &kp I     &kp O    &kp P    &kp BSPC
&kp LCTRL &kp A    &kp S    &kp D     &kp F     &kp G        &kp H   &kp J     &kp K     &kp L    &kp SEMI &kp SQT
&kp LSHFT &kp Z    &kp X    &kp C     &kp V     &kp B        &kp N   &kp M     &kp COMMA &kp DOT  &kp FSLH &kp RET
&kp ESC   &kp LGUI &kp LALT &kp LANG2 &mo LOWER &kp SPACE    &kp RET &mo RAISE &kp LANG1 &kp RALT &kp DEL  &kp RSHFT
            >;
        };

        // 1: 数字・矢印
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp GRAVE &kp N1   &kp N2   &kp N3   &kp N4   &kp N5       &kp N6   &kp N7   &kp N8   &kp N9    &kp N0   &kp BSPC
&trans    &trans   &trans   &trans   &trans   &trans       &kp LEFT &kp DOWN &kp UP   &kp RIGHT &trans   &trans
&trans    &trans   &trans   &trans   &trans   &trans       &kp HOME &kp PG_DN &kp PG_UP &kp END &trans   &trans
&trans    &trans   &trans   &trans   &trans   &trans       &trans   &trans   &trans   &trans    &trans   &trans
            >;
        };

        // 2: 記号・ファンクション・Bluetooth
        raise_layer {
            display-name = "Raise";
            bindings = <
&kp TILDE    &kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR   &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
&kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
&kp F7       &kp F8       &kp F9       &kp F10      &kp F11      &kp F12      &trans    &trans    &trans    &trans   &trans   &trans
            >;
        };

        // 3: マウス (ボールを動かすと自動でON)
        //    右手 J=左クリック K=中クリック L=右クリック ;=スクロール
        //    左手 F=左クリック D=中クリック S=右クリック A=スクロール (ボールが左手側でも使えるように)
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans &trans     &trans    &trans    &trans    &trans    &trans &trans    &trans    &trans    &trans     &trans
&trans &mo SCROLL &mkp RCLK &mkp MCLK &mkp LCLK &trans    &trans &mkp LCLK &mkp MCLK &mkp RCLK &mo SCROLL &trans
&trans &trans     &trans    &mkp MB5  &mkp MB4  &trans    &trans &mkp MB4  &mkp MB5  &trans    &trans     &trans
&trans &trans     &trans    &trans    &trans    &trans    &trans &trans    &trans    &trans    &trans     &trans
            >;
        };

        // 4: スクロール (マウスレイヤーのスクロールキーを押している間)
        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans &trans &trans    &trans    &trans    &trans    &trans &trans    &trans    &trans    &trans &trans
&trans &trans &mkp RCLK &mkp MCLK &mkp LCLK &trans    &trans &mkp LCLK &mkp MCLK &mkp RCLK &trans &trans
&trans &trans &trans    &trans    &trans    &trans    &trans &trans    &trans    &trans    &trans &trans
&trans &trans &trans    &trans    &trans    &trans    &trans &trans    &trans    &trans    &trans &trans
            >;
        };
    };
};
