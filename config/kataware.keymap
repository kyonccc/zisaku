/*
 * kataware キーマップ
 *
 * キーの割り当てはこのファイルを編集して変更します。
 * キーコード一覧: https://zmk.dev/docs/keymaps/list-of-keycodes
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

// レイヤー番号に名前を付けておく (数字を直接書くより分かりやすい)
#define BASE   0
#define LOWER  1
#define RAISE  2
#define MOUSE  3
#define SCROLL 4

/*
 * ===== トラックボールの動作設定 =====
 * - ボールを動かすと MOUSE レイヤーが自動でONになる (オートマウスレイヤー)
 *   → 右手ホームポジションのキーがクリックになる
 * - SCROLL レイヤー中はボールでスクロールする
 */
&zip_temp_layer {
    // 文字入力の直後 300ms はボールに触れてもマウスレイヤーにしない (誤爆防止)
    require-prior-idle-ms = <300>;
};

&trackball_listener {
    // 通常時: ボールを動かすと MOUSE レイヤーを 700ms だけONにする
    input-processors = <&zip_temp_layer MOUSE 700>;

    scroller {
        layers = <SCROLL>;
        // XY移動をスクロールに変換し、速度を 1/8 に落とす
        // スクロール方向が逆なら &zip_scroll_transform INPUT_TRANSFORM_Y_INVERT を追加
        input-processors = <&zip_xy_to_scroll_mapper &zip_scroll_scaler 1 8>;
    };
};

/*
 * キー配置図 (オーソリニア / 左24キー + 右22キー = 46キー + エンコーダー)
 *
 *  Q    W    E    R     T     -                    [     Y     U     I    O    P
 *  A    S    D    F     G     '                    ]     H     J     K    L    ;
 *  Z    X    C    V     B    (◎)              ●          N     M     ,    .    /
 *  Sft  Tab  Ctl  Lower Space 英数 Raise                 Enter Raise BS   かな  Sft
 *                            ↑ エンコーダー    ↑ トラックボール (右手・内側)
 *
 * エンコーダー (sensor-bindings): 回す = 音量 (Lower中はページ送り、Raise中は画面の明るさ)
 *                                押す = ミュート
 *
 * &mt A B = 「タップで B、長押しで A」
 *   Ctl  : タップで Esc、長押しで Ctrl
 *   英数 : タップで 英数、長押しで GUI(Win/Cmd)
 *   かな : タップで かな、長押しで Alt(Option)
 */
/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: 基本レイヤー (QWERTY)
        base_layer {
            display-name = "Base";
            bindings = <
&kp Q     &kp W   &kp E         &kp R     &kp T     &kp MINUS                   &kp LBKT &kp Y   &kp U     &kp I     &kp O          &kp P
&kp A     &kp S   &kp D         &kp F     &kp G     &kp SQT                     &kp RBKT &kp H   &kp J     &kp K     &kp L          &kp SEMI
&kp Z     &kp X   &kp C         &kp V     &kp B     &kp C_MUTE                           &kp N   &kp M     &kp COMMA &kp DOT        &kp FSLH
&kp LSHFT &kp TAB &mt LCTRL ESC &mo LOWER &kp SPACE &mt LGUI LANG2 &mo RAISE             &kp RET &mo RAISE &kp BSPC  &mt LALT LANG1 &kp RSHFT
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // 1: 数字・矢印
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp N1    &kp N2 &kp N3 &kp N4 &kp N5 &trans           &trans &kp N6   &kp N7    &kp N8    &kp N9    &kp N0
&kp GRAVE &trans &trans &trans &trans &trans           &trans &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &kp SQT
&trans    &trans &trans &trans &trans &trans                  &kp HOME &kp PG_DN &kp PG_UP &kp END   &trans
&trans    &trans &trans &trans &trans &trans &trans           &trans   &trans    &kp DEL   &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp PG_DN PG_UP>;
        };

        // 2: 記号・ファンクション・Bluetooth
        //    内側の追加キー: 上段 = ファームウェア書き込みモード (bootloader)、2段目 = 再起動 (reset)
        //    押した側 (左なら左、右なら右) が書き込みモードになる
        raise_layer {
            display-name = "Raise";
            bindings = <
&kp EXCL     &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &bootloader           &bootloader &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &sys_reset            &sys_reset  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH
&kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &trans                            &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE
&kp F6       &kp F7       &kp F8       &kp F9       &kp F10      &bt BT_CLR  &trans                &trans    &trans    &kp F11   &kp F12  &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        // 3: マウス (ボールを動かすと自動でON)
        //    右手 J=左クリック K=中クリック L=右クリック ;=スクロール
        //    左手 F=左クリック D=中クリック S=右クリック A=スクロール
        mouse_layer {
            display-name = "Mouse";
            bindings = <
&trans     &trans    &trans    &trans    &trans &trans           &trans &trans &trans    &trans    &trans    &trans
&mo SCROLL &mkp RCLK &mkp MCLK &mkp LCLK &trans &trans           &trans &trans &mkp LCLK &mkp MCLK &mkp RCLK &mo SCROLL
&trans     &trans    &mkp MB5  &mkp MB4  &trans &trans                  &trans &mkp MB4  &mkp MB5  &trans    &trans
&trans     &trans    &trans    &trans    &trans &trans &trans           &trans &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // 4: スクロール (マウスレイヤーのスクロールキーを押している間)
        scroll_layer {
            display-name = "Scroll";
            bindings = <
&trans &trans    &trans    &trans    &trans &trans           &trans &trans &trans    &trans    &trans    &trans
&trans &mkp RCLK &mkp MCLK &mkp LCLK &trans &trans           &trans &trans &mkp LCLK &mkp MCLK &mkp RCLK &trans
&trans &trans    &trans    &trans    &trans &trans                  &trans &trans    &trans    &trans    &trans
&trans &trans    &trans    &trans    &trans &trans &trans           &trans &trans    &trans    &trans    &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
